# ─── Vago 本地联调环境变量模板 ──────────────────────────────────────────────────
# 使用方法：cp .env.example .env，然后修改 .env 中的值
# .env 文件已加入 .gitignore，不会提交到仓库

# ── MySQL ───────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=vago
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── JWT / SMS（FastAPI 迁移期与 Java 后端共享）──────────────────────────────────
JWT_SECRET_KEY=replace_with_shared_secret
JWT_TOKEN_NAME=authorization
JWT_ACCESS_TOKEN_TTL_SECONDS=7200
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
SMS_CODE_TTL_SECONDS=300
SMS_LIMIT_TTL_SECONDS=60

# ── Qdrant（向量数据库）──────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── OpenAI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ── 服务端口 ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
WEB_PORT=5173

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
VAGO_GITHUB_CLIENT_ID=your_github_client_id
VAGO_GITHUB_CLIENT_SECRET=your_github_client_secret
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/login
