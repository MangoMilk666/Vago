<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>Vago</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <!-- Xcode 用该字段将安装包与构建产物中的 VagoIOS 可执行文件关联。 -->
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key><string>Vago</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <!-- 使用系统原生启动屏，避免自定义 plist 缺少启动屏配置时出现不一致的首屏过渡。 -->
    <key>UILaunchScreen</key><dict/>
    <!-- 指定API请求的发送地址 本机simulator调试可用127.0.0.1 -->
    <!-- 真机调试iOS端需要用Mac局域网ip 172.20.10.7 手机热点-->
    <!-- 真机调试iOS端需要用Mac局域网ip 192.168.10.212 房间家庭宽带-->
    <!-- 以后 Wi-Fi 再变化时，在 Mac 终端执行：ipconfig getifaddr en0 -->
    <!-- 将输出的新 IP 替换到同一个 VAGO_API_BASE_URL 配置即可。 -->
    <key>VAGO_API_BASE_URL</key><string>http://192.168.10.212:8000/api/v1</string>
    <!-- 仅在用户进入“记录”页并开始记录时申请定位权限。 -->
    <key>NSLocationWhenInUseUsageDescription</key><string>Vago 使用你的位置记录当前旅行的足迹，并支持在当前位置打卡。</string>
    <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict></plist>
