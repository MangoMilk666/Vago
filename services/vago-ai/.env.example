# =============================================================================
# Vago AI 服务环境变量配置模板
# 复制为 .env 后填写实际值：cp .env.example .env
# =============================================================================

# ─── 方案 A：OpenAI 官方（默认，不填 base_url） ────────────────────────────────
# EMBED_API_KEY=sk-...
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIM=1536

# ─── 方案 B：阿里云百炼（DashScope OpenAI 兼容模式） ──────────────────────────
# 控制台：https://bailian.console.aliyun.com/ → API Keys
#
# EMBED_API_KEY=sk-...
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-v3
# OPENAI_EMBEDDING_DIM=1024       # text-embedding-v3 输出 1024 维
#
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus             # 可选：qwen-turbo / qwen-plus / qwen-max

# ─── 方案 C：Embedding 用 OpenAI，LLM 用阿里云百炼（混合） ──────────────────────
# OPENAI_API_KEY=sk-...           # 仅用于 Embedding
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIM=1536
#
# LLM_API_KEY=sk-...              # 百炼 API Key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# =============================================================================
# 以下配置与 Provider 无关，通常无需修改
# =============================================================================

# FastAPI application
APP_NAME=Vago API
APP_VERSION=0.4.0-remould-phase2
API_V1_PREFIX=/api/v1
ENVIRONMENT=local
DEBUG=false

# MySQL relational database foundation
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/vago
DATABASE_ECHO=false

# Qdrant 向量数据库（本地 Docker：docker run -p 6333:6333 qdrant/qdrant）
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=vago_articles

# 语义分块参数
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# 攻略内容字符上限（超出拒绝入库）
MAX_CONTENT_CHARS=50000

# RAG 检索参数
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.55

# LLM 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# JWT / Redis shared with the legacy Java backend during migration
JWT_SECRET_KEY=
JWT_TOKEN_NAME=authorization
JWT_ACCESS_TOKEN_TTL_SECONDS=7200
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
SMS_CODE_TTL_SECONDS=300
SMS_LIMIT_TTL_SECONDS=60
ACCOUNT_CANCEL_GRACE_SECONDS=604800
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_USER_URL=https://api.github.com/user
GITHUB_OAUTH_EMAILS_URL=https://api.github.com/user/emails
